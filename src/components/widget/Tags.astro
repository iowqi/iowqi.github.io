---
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import {
	extractLangFromPath,
	getTranslation,
	normalizeLang,
} from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	lang?: string;
}
const { class: className, style, lang: langProp } = Astro.props;

const pageLang = normalizeLang(
	langProp || extractLangFromPath(Astro.url.pathname) || siteConfig.lang,
);
const t = getTranslation(pageLang);
const tags = await getTagList();

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;
---
<WidgetLayout name={t[I18nKey.tags]} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style} lang={pageLang}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(t => (
            <ButtonTag href={getTagUrl(t.name)} label={`View all posts with the ${t.name.trim()} tag`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>