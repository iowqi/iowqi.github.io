		transition: all 0.2s ease;
		min-height: 32px;
	}

	:global(.calendar-day[data-has-post="true"]:hover) {
		transform: translateY(-2px);
	}

	:global(.calendar-day-in-range) {
		border-radius: 0.25rem;
		background-color: color-mix(in oklch, var(--primary) 28%, var(--card-bg));
		box-shadow: inset 0 0 0 2px color-mix(in oklch, var(--primary) 52%, transparent);
	}

	:global(html.dark .calendar-day-in-range) {
		background-color: color-mix(in oklch, var(--primary) 36%, var(--card-bg));
		box-shadow: inset 0 0 0 2px color-mix(in oklch, var(--primary) 68%, transparent);
	}

	:global(.calendar-day-range-preview) {
		border-radius: 0.25rem;
		background-color: color-mix(in oklch, var(--primary) 16%, var(--card-bg));
		box-shadow: inset 0 0 0 1.5px color-mix(in oklch, var(--primary) 40%, transparent);
	}

	:global(html.dark .calendar-day-range-preview) {
		background-color: color-mix(in oklch, var(--primary) 22%, var(--card-bg));
		box-shadow: inset 0 0 0 1.5px color-mix(in oklch, var(--primary) 55%, transparent);
	}
</style>
