---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import {
	extractLangFromPath,
	normalizeLang,
} from "@/i18n/translation";
import Calendar from "./Calendar.astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	lang?: string;
}

const { class: className, lang: langProp } = Astro.props;

const pageLang = normalizeLang(
	langProp || extractLangFromPath(Astro.url.pathname) || siteConfig.lang,
);
---

<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile />
    </div>
    <div
        id="sidebar-sticky"
        class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-4"
    >
        <Categories class="onload-animation" style="animation-delay: 150ms" lang={pageLang} />
        <Tag class="onload-animation" style="animation-delay: 200ms" lang={pageLang} />
        <Calendar class="onload-animation" style="animation-delay: 250ms" lang={pageLang} />
    </div>
</div>
