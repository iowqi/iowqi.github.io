---
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import {
	extractLangFromPath,
	getTranslation,
	normalizeLang,
} from "../../i18n/translation";
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	lang?: string;
}
const { class: className, style, lang: langProp } = Astro.props;

const pageLang = normalizeLang(
	langProp || extractLangFromPath(Astro.url.pathname) || siteConfig.lang,
);
const t = getTranslation(pageLang);
const categories = await getCategoryList(pageLang);

const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

const isCollapsed = categories.length >= COLLAPSE_THRESHOLD;
---

<WidgetLayout name={t[I18nKey.categories]} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style} lang={pageLang}
>
    {categories.map((c) =>
        <ButtonLink
            url={c.url}
            badge={String(c.count)}
            label={`View all posts in the ${c.name.trim()} category`}
        >
            {c.name.trim()}
        </ButtonLink>
    )}
</WidgetLayout>