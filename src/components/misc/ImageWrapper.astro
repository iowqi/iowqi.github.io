---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	darkSrc?: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	darkSrc,
	alt,
	position = "center",
	basePath = "/",
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
const files = import.meta.glob<ImageMetadata>("../../**", {
	import: "default",
});

async function resolveLocalImage(source: string | undefined) {
	if (!source || !isLocalPath(source)) return undefined;
	const normalizedPath = path
		.normalize(path.join("../../", basePath, source))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
		return undefined;
	}
	return await file();
}

function isLocalPath(source: string) {
	return !(
		source.startsWith("/") ||
		source.startsWith("http") ||
		source.startsWith("https") ||
		source.startsWith("data:")
	);
}

const darkIsLocal = !!darkSrc && isLocalPath(darkSrc);
const darkIsPublic = !!darkSrc && darkSrc.startsWith("/");

const img = await resolveLocalImage(src);
const darkImg = await resolveLocalImage(darkSrc);

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {darkSrc ? (
        <>
            {isLocal && img && <Image src={img} alt={alt || ""} class={`${imageClass} block dark:hidden`} style={imageStyle}/>}
            {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={`${imageClass} block dark:hidden`} style={imageStyle}/>}

            {darkIsLocal && darkImg && <Image src={darkImg} alt={alt || ""} class={`${imageClass} hidden dark:block`} style={imageStyle}/>}
            {!darkIsLocal && darkSrc && <img src={darkIsPublic ? url(darkSrc) : darkSrc} alt={alt || ""} class={`${imageClass} hidden dark:block`} style={imageStyle}/>}
        </>
    ) : (
        <>
            {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle}/>}
            {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}/>}
        </>
    )}
</div>
