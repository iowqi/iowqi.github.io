---
import ArchivePageContent from "@components/pages/ArchivePageContent.astro";
import {
	getLangStaticPaths,
	setupI18nLangFromAstro,
} from "@utils/i18n-route-utils";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	return getLangStaticPaths();
}) satisfies GetStaticPaths;

const lang = setupI18nLangFromAstro(Astro);
---

<ArchivePageContent lang={lang} />
