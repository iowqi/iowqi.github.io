---
import type { GetStaticPaths } from "astro";
import PaginatedPostsPageContent from "@components/pages/PaginatedPostsPageContent.astro";
import { PAGE_SIZE } from "@constants/constants";
import { supportedLanguages } from "@i18n/translation";
import { getSortedPosts } from "@utils/content-utils";
import { setupI18nLangFromAstro } from "@utils/i18n-route-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return supportedLanguages.flatMap((lang) =>
		paginate(allBlogPosts, { pageSize: PAGE_SIZE, params: { lang } }),
	);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = setupI18nLangFromAstro(Astro);
---

<PaginatedPostsPageContent page={page} lang={lang} />
