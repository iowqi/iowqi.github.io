---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import { extractLangFromPath, normalizeLang } from "@i18n/translation";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { isHomePath } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const bannerSrc = siteConfig.banner.src;
const bannerDarkSrc = bannerSrc.includes(".")
	? bannerSrc.replace(/(\.[^./]+)$/, "-dark$1")
	: `${bannerSrc}-dark`;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

const bannerParallaxConfig = {
	enable: siteConfig.banner.parallax?.enable ?? false,
	maxOffset: siteConfig.banner.parallax?.maxOffset ?? 38,
	scrollFactor: siteConfig.banner.parallax?.scrollFactor ?? 0.12,
	spring: siteConfig.banner.parallax?.spring ?? 0.08,
	damping: siteConfig.banner.parallax?.damping ?? 0.82,
	targetDecay: siteConfig.banner.parallax?.targetDecay ?? 0.92,
};

const welcomeTextContent = siteConfig.banner.welcomeText?.content;
const welcomeTextList = (
	Array.isArray(welcomeTextContent)
		? welcomeTextContent
		: [welcomeTextContent ?? "Welcome"]
).filter(
	(text): text is string => typeof text === "string" && text.trim().length > 0,
);

const bannerWelcomeConfig = {
	enable: siteConfig.banner.welcomeText?.enable ?? true,
	contents: welcomeTextList.length > 0 ? welcomeTextList : ["Welcome"],
	typingSpeed: siteConfig.banner.welcomeText?.typingSpeed ?? 120,
	holdAfterTypedMs: siteConfig.banner.welcomeText?.holdAfterTypedMs ?? 1000,
	holdAfterDeletedMs: siteConfig.banner.welcomeText?.holdAfterDeletedMs ?? 280,
	fontFamily:
		siteConfig.banner.welcomeText?.fontFamily ??
		'"Space Grotesk", "Segoe UI", "Inter", system-ui, -apple-system, sans-serif',
	fontWeight: siteConfig.banner.welcomeText?.fontWeight ?? 800,
	fontSizeMobileRem: siteConfig.banner.welcomeText?.fontSizeMobileRem ?? 3,
	fontSizeDesktopRem: siteConfig.banner.welcomeText?.fontSizeDesktopRem ?? 4.5,
	letterSpacingEm: siteConfig.banner.welcomeText?.letterSpacingEm ?? 0.16,
	lineHeight: siteConfig.banner.welcomeText?.lineHeight ?? 1.3,
	containerPaddingYRem:
		siteConfig.banner.welcomeText?.containerPaddingYRem ?? 0.55,
	gradientDurationMs: siteConfig.banner.welcomeText?.gradientDurationMs ?? 5200,
	waveDurationMs: siteConfig.banner.welcomeText?.waveDurationMs ?? 2600,
	waveAmplitudePx: siteConfig.banner.welcomeText?.waveAmplitudePx ?? 16.8,
	waveRotateDeg: siteConfig.banner.welcomeText?.waveRotateDeg ?? 5.2,
};

const showBannerWelcomeOnLoad = isHomePath(Astro.url.pathname);

const resolvedPageLang = normalizeLang(
	lang || extractLangFromPath(Astro.url.pathname) || siteConfig.lang,
);
---

<Layout
    title={title}
    banner={banner}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
>
    <!-- Navbar -->
    <slot slot="head" name="head" />
    <div
        id="top-row"
        class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto"
        class:list={[""]}
    >
        <div
            id="navbar-wrapper"
            class="pointer-events-auto sticky top-0 transition-all"
        >
            <Navbar />
        </div>
    </div>

    <!-- Banner -->
    {
        siteConfig.banner.enable && (
            <div
                id="banner-wrapper"
                class={`absolute z-10 w-full transition duration-700`}
                style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
            >
                <div id="banner-parallax-layer" class="relative h-full">
                    <div class="h-full overflow-hidden">
                        <ImageWrapper
                            id="banner"
                            alt="Banner image of the blog"
                            class:list={[
                                "object-cover h-full transition duration-700 opacity-0 scale-105",
                            ]}
                            src={bannerSrc}
                            darkSrc={bannerDarkSrc}
                            position={siteConfig.banner.position}
                            data-banner-parallax
                        />
                    </div>
                    <div
                        aria-hidden="true"
                        data-banner-gradient
                        class="pointer-events-none absolute inset-x-0 -bottom-px h-[2px] bg-[var(--page-bg)]"
                    />
                    <div
                        aria-hidden="true"
                        data-banner-gradient
                        class="pointer-events-none absolute inset-x-0 bottom-0 h-32 md:h-40 bg-gradient-to-t from-[var(--page-bg)] via-[var(--page-bg)]/70 to-transparent"
                    />
                    <div
                        aria-hidden="true"
                        data-banner-gradient
                        class="pointer-events-none absolute inset-x-0 top-full h-24 md:h-32 bg-gradient-to-b from-[var(--page-bg)] via-[var(--page-bg)]/70 to-transparent"
                    />
                    {bannerWelcomeConfig.enable && (
                        <div
                            id="banner-welcome-layer"
                            class:list={[
                                "pointer-events-none absolute inset-0 z-20 flex items-center justify-center overflow-visible px-4 transition-opacity duration-200 ease-out motion-reduce:transition-none",
                                showBannerWelcomeOnLoad
                                    ? "opacity-100"
                                    : "opacity-0",
                            ]}
                            style={`padding-top:${bannerWelcomeConfig.containerPaddingYRem}rem;padding-bottom:${bannerWelcomeConfig.containerPaddingYRem}rem;`}
                            aria-hidden={
                                showBannerWelcomeOnLoad ? "false" : "true"
                            }
                        >
                            <h1
                                id="banner-welcome-text"
                                class="opacity-0 banner-welcome-modern"
                                style={`--banner-welcome-font-family:${bannerWelcomeConfig.fontFamily};--banner-welcome-font-weight:${bannerWelcomeConfig.fontWeight};--banner-welcome-size-mobile:${bannerWelcomeConfig.fontSizeMobileRem}rem;--banner-welcome-size-desktop:${bannerWelcomeConfig.fontSizeDesktopRem}rem;--banner-welcome-letter-spacing:${bannerWelcomeConfig.letterSpacingEm}em;--banner-welcome-line-height:${bannerWelcomeConfig.lineHeight};--banner-welcome-gradient-duration:${bannerWelcomeConfig.gradientDurationMs}ms;--banner-welcome-wave-duration:${bannerWelcomeConfig.waveDurationMs}ms;--banner-welcome-wave-amplitude:${bannerWelcomeConfig.waveAmplitudePx}px;--banner-welcome-wave-rotate:${bannerWelcomeConfig.waveRotateDeg}deg;`}
                                data-full-texts={JSON.stringify(
                                    bannerWelcomeConfig.contents,
                                )}
                                data-typing-speed={
                                    bannerWelcomeConfig.typingSpeed
                                }
                                data-hold-after-typed-ms={
                                    bannerWelcomeConfig.holdAfterTypedMs
                                }
                                data-hold-after-deleted-ms={
                                    bannerWelcomeConfig.holdAfterDeletedMs
                                }
                                data-wave-duration-ms={
                                    bannerWelcomeConfig.waveDurationMs
                                }
                                aria-label={bannerWelcomeConfig.contents.join(
                                    " / ",
                                )}
                            />
                        </div>
                    )}
                </div>
            </div>
        )
    }

    <!-- Main content -->
    <div
        class="absolute w-full z-30 pointer-events-none"
        style={`top: ${mainPanelTop}`}
    >
        <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
        <div
            class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto"
        >
            <div
                id="main-grid"
                class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_minmax(0,1fr)] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
            >
                <!-- Banner image credit -->
                {
                    hasBannerCredit && (
                        <a
                            href={siteConfig.banner.credit.url}
                            id="banner-credit"
                            target="_blank"
                            rel="noopener"
                            aria-label="Visit image source"
                            class:list={[
                                "group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                    "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9",
                                {
                                    "hover:pr-9 active:bg-black/80":
                                        hasBannerLink,
                                },
                            ]}
                        >
                            <Icon
                                class="text-white/75 text-[1.25rem] mr-1"
                                name="material-symbols:copyright-outline-rounded"
                            />
                            <div class="text-white/75 text-xs">
                                {siteConfig.banner.credit.text}
                            </div>
                            <Icon
                                class:list={[
                                    "transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                                    {
                                        "group-hover:opacity-100":
                                            hasBannerLink,
                                    },
                                ]}
                                name="fa6-solid:arrow-up-right-from-square"
                            />
                        </a>
                    )
                }

                <SideBar
                    class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation"
                    headings={headings}
                    lang={resolvedPageLang}
                />

                <main
                    id="swup-container"
                    class="transition-swup-fade col-span-2 lg:col-span-1 min-w-0 overflow-visible"
                >
                    <div id="content-wrapper" class="onload-animation min-w-0">
                        <!-- the overflow-hidden here prevent long text break the layout-->
                        <!-- make id different from windows.swup global property -->
                        <slot />
                        <div
                            class="footer col-span-2 onload-animation hidden lg:block"
                        >
                            <Footer />
                        </div>
                    </div>
                </main>

                <div class="footer col-span-2 onload-animation block lg:hidden">
                    <Footer />
                </div>
            </div>

            <BackToTop />
        </div>
    </div>

    <!-- The things that should be under the banner, only the TOC for now -->
    <div class="absolute w-full z-0 hidden 2xl:block">
        <div class="relative max-w-[var(--page-width)] mx-auto">
            <!-- TOC component -->
            {
                siteConfig.toc.enable && (
                    <div
                        id="toc-wrapper"
                        class:list={[
                            "hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
                            { "toc-hide": siteConfig.banner.enable },
                        ]}
                    >
                        <div
                            id="toc-inner-wrapper"
                            class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar"
                        >
                            <div
                                id="toc"
                                class="w-full h-full transition-swup-fade "
                            >
                                <div class="h-8 w-full" />
                                <TOC headings={headings} />
                                <div class="h-8 w-full" />
                            </div>
                        </div>
                    </div>
                )
            }

            <!-- #toc needs to exist for Swup to work normally -->
            {!siteConfig.toc.enable && <div id="toc" />}
        </div>
    </div>

    <script is:inline define:vars={{ bannerParallaxConfig }}>
        (() => {
            let cleanup = null;

            const init = () => {
                if (cleanup) {
                    cleanup();
                    cleanup = null;
                }

                const banner = document.querySelector("#banner");
                const parallaxLayer = document.querySelector(
                    "#banner-parallax-layer",
                );

                if (!banner || !parallaxLayer) return;

                let current = 0;
                let velocity = 0;
                let target = 0;
                let rafId = 0;
                let running = false;
                let lastScrollY = window.scrollY;

                if (!bannerParallaxConfig?.enable) return;

                const maxOffset = Number(bannerParallaxConfig.maxOffset) || 38;
                const scrollFactor =
                    Number(bannerParallaxConfig.scrollFactor) || 0.12;
                const spring = Number(bannerParallaxConfig.spring) || 0.08;
                const damping = Number(bannerParallaxConfig.damping) || 0.82;
                const targetDecay =
                    Number(bannerParallaxConfig.targetDecay) || 0.92;

                const clamp = (value, min, max) =>
                    Math.max(min, Math.min(max, value));

                const render = (y) => {
                    parallaxLayer.style.transform = `translate3d(0, ${y}px, 0)`;
                    // Keep Layout.astro translate-y on #banner for object-position framing; do not override.
                    // Gradient overlays move with this layer only; a separate multiplier caused visible seams
                    // vs the clipped image and --page-bg during fast smooth-scroll / spring settle.
                };

                const animate = () => {
                    target *= targetDecay;

                    const force = (target - current) * spring;
                    velocity = (velocity + force) * damping;
                    current += velocity;

                    render(current);

                    const stillMoving =
                        Math.abs(velocity) > 0.02 ||
                        Math.abs(current) > 0.02 ||
                        Math.abs(target) > 0.02;

                    if (stillMoving) {
                        rafId = requestAnimationFrame(animate);
                        return;
                    }

                    current = 0;
                    velocity = 0;
                    target = 0;
                    render(0);
                    running = false;
                };

                const onScroll = () => {
                    const y = window.scrollY;
                    const delta = y - lastScrollY;
                    lastScrollY = y;

                    target = clamp(
                        target + delta * scrollFactor,
                        -maxOffset,
                        maxOffset,
                    );

                    if (!running) {
                        running = true;
                        rafId = requestAnimationFrame(animate);
                    }
                };

                window.addEventListener("scroll", onScroll, { passive: true });
                document.documentElement.setAttribute(
                    "data-banner-parallax-active",
                    "true",
                );

                cleanup = () => {
                    window.removeEventListener("scroll", onScroll);
                    cancelAnimationFrame(rafId);
                    document.documentElement.removeAttribute(
                        "data-banner-parallax-active",
                    );
                };
            };

            init();
            document.addEventListener("astro:page-load", init);
            document.addEventListener("astro:before-swap", () => {
                if (cleanup) {
                    cleanup();
                    cleanup = null;
                }
            });
        })();
    </script>

    <script>
        import { isHomePath } from "../utils/url-utils";

        const stateKey = "__bannerWelcomeTypeState";
        const WELCOME_LAYER_ID = "banner-welcome-layer";

        type BannerWelcomeState = {
            domListenersAttached: boolean;
            swupHookAttached: boolean;
            swupEnableListenerAttached: boolean;
            lastPathHome: boolean;
            textEl: HTMLElement | null;
            texts: string[];
            typingSpeed: number;
            deletingSpeed: number;
            holdAfterTypedMs: number;
            holdAfterDeletedMs: number;
            cursorVisible: boolean;
            textIndex: number;
            charIndex: number;
            isDeleting: boolean;
            typeTimer: number | null;
            pauseTimer: number | null;
            cursorTimer: number | null;
            bindFromDom: () => void;
            render: () => void;
            step: () => void;
            start: () => void;
            clearTimers: () => void;
            syncWelcomeFromRoute: () => void;
            onVisitStart: (visit: { to: { url: string } }) => void;
        };

        const w = window as unknown as Record<
            string,
            BannerWelcomeState | undefined
        >;

        function createDefaultState(): BannerWelcomeState {
            return {
                domListenersAttached: false,
                swupHookAttached: false,
                swupEnableListenerAttached: false,
                lastPathHome: isHomePath(window.location.pathname),
                textEl: null,
                texts: ["Welcome"],
                typingSpeed: 120,
                deletingSpeed: 84,
                holdAfterTypedMs: 1000,
                holdAfterDeletedMs: 280,
                cursorVisible: true,
                textIndex: 0,
                charIndex: 0,
                isDeleting: false,
                typeTimer: null,
                pauseTimer: null,
                cursorTimer: null,
                bindFromDom: () => {},
                render: () => {},
                step: () => {},
                start: () => {},
                clearTimers: () => {},
                syncWelcomeFromRoute: () => {},
                onVisitStart: () => {},
            };
        }

        if (!w[stateKey]) {
            w[stateKey] = createDefaultState();
        }
        const state = w[stateKey]!;

        function applyWelcomeLayerVisible(home: boolean) {
            const layer = document.getElementById(WELCOME_LAYER_ID);
            if (!layer) return;
            if (home) {
                layer.classList.remove("opacity-0");
                layer.classList.add("opacity-100");
                layer.setAttribute("aria-hidden", "false");
            } else {
                layer.classList.remove("opacity-100");
                layer.classList.add("opacity-0");
                layer.setAttribute("aria-hidden", "true");
            }
        }

        const clearTimers = () => {
            if (state.typeTimer) {
                window.clearTimeout(state.typeTimer);
                state.typeTimer = null;
            }
            if (state.pauseTimer) {
                window.clearTimeout(state.pauseTimer);
                state.pauseTimer = null;
            }
            if (state.cursorTimer) {
                window.clearInterval(state.cursorTimer);
                state.cursorTimer = null;
            }
        };

        const escapeHtml = (value: string) =>
            value
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        const renderWaveText = (
            el: HTMLElement,
            typed: string,
            withCursor: boolean,
        ) => {
            const waveDurationAttr = Number(
                el.getAttribute("data-wave-duration-ms"),
            );
            const waveDurationMs =
                Number.isFinite(waveDurationAttr) && waveDurationAttr > 0
                    ? waveDurationAttr
                    : 2600;
            const nowMs = Date.now();

            const chars = [...typed]
                .map((char, i) => {
                    const safeChar = char === " " ? "&nbsp;" : escapeHtml(char);
                    const delayMs = -((nowMs + i * 90) % waveDurationMs);
                    return `<span class="banner-welcome-wave-char" style="--wave-index:${i};animation-delay:${delayMs}ms">${safeChar}</span>`;
                })
                .join("");

            const cursor = withCursor
                ? `<span class="banner-welcome-caret">_</span>`
                : "";
            el.innerHTML = chars + cursor;
        };

        const parseTexts = (textEl: HTMLElement) => {
            const raw = textEl.getAttribute("data-full-texts");
            if (!raw) return ["Welcome"];

            try {
                const parsed = JSON.parse(raw);
                if (!Array.isArray(parsed)) return ["Welcome"];

                const texts = parsed
                    .filter((item: unknown) => typeof item === "string")
                    .map((item: string) => item.trim())
                    .filter((item: string) => item.length > 0);

                return texts.length > 0 ? texts : ["Welcome"];
            } catch {
                return ["Welcome"];
            }
        };

        const bindFromDom = () => {
            const textEl = document.getElementById("banner-welcome-text");
            if (!textEl) return;

            const home = isHomePath(window.location.pathname);
            if (!home) {
                clearTimers();
                applyWelcomeLayerVisible(false);
                textEl.classList.add("opacity-0");
                state.textEl = textEl;
                return;
            }

            applyWelcomeLayerVisible(true);

            const texts = parseTexts(textEl);
            const typingSpeedAttr = Number(
                textEl.getAttribute("data-typing-speed"),
            );
            const typingSpeed =
                Number.isFinite(typingSpeedAttr) && typingSpeedAttr > 0
                    ? typingSpeedAttr
                    : 120;
            const deletingSpeed = Math.max(45, Math.floor(typingSpeed * 0.7));
            const holdAfterTypedAttr = Number(
                textEl.getAttribute("data-hold-after-typed-ms"),
            );
            const holdAfterTypedMs =
                Number.isFinite(holdAfterTypedAttr) && holdAfterTypedAttr >= 0
                    ? holdAfterTypedAttr
                    : 1000;
            const holdAfterDeletedAttr = Number(
                textEl.getAttribute("data-hold-after-deleted-ms"),
            );
            const holdAfterDeletedMs =
                Number.isFinite(holdAfterDeletedAttr) &&
                holdAfterDeletedAttr >= 0
                    ? holdAfterDeletedAttr
                    : 280;

            state.textEl = textEl;
            state.texts = texts.length > 0 ? texts : ["Welcome"];
            state.typingSpeed = typingSpeed;
            state.deletingSpeed = deletingSpeed;
            state.holdAfterTypedMs = holdAfterTypedMs;
            state.holdAfterDeletedMs = holdAfterDeletedMs;
            state.textIndex = state.textIndex % state.texts.length;

            textEl.classList.remove("opacity-0");
            state.render();
        };

        const render = () => {
            if (!state.textEl) return;
            const currentText = state.texts[state.textIndex] ?? "";
            const typed = currentText.slice(0, state.charIndex);
            renderWaveText(state.textEl, typed, state.cursorVisible);
        };

        const step = () => {
            const currentText = state.texts[state.textIndex] ?? "";

            if (!state.isDeleting) {
                if (state.charIndex < currentText.length) {
                    state.charIndex += 1;
                    render();
                    state.typeTimer = window.setTimeout(
                        step,
                        state.typingSpeed,
                    );
                    return;
                }

                state.pauseTimer = window.setTimeout(() => {
                    state.isDeleting = true;
                    step();
                }, state.holdAfterTypedMs);
                return;
            }

            if (state.charIndex > 0) {
                state.charIndex -= 1;
                render();
                state.typeTimer = window.setTimeout(step, state.deletingSpeed);
                return;
            }

            state.textIndex = (state.textIndex + 1) % state.texts.length;
            state.isDeleting = false;
            state.pauseTimer = window.setTimeout(
                step,
                state.holdAfterDeletedMs,
            );
        };

        const start = () => {
            clearTimers();
            state.cursorTimer = window.setInterval(() => {
                state.cursorVisible = !state.cursorVisible;
                render();
            }, 420);

            render();
            state.typeTimer = window.setTimeout(step, state.typingSpeed);
        };

        const syncWelcomeFromRoute = () => {
            const home = isHomePath(window.location.pathname);
            const wasHome = state.lastPathHome;
            state.lastPathHome = home;

            bindFromDom();

            if (home && state.textEl) {
                if (!wasHome) {
                    state.textIndex = 0;
                    state.charIndex = 0;
                    state.isDeleting = false;
                    state.cursorVisible = true;
                }
                start();
            } else {
                clearTimers();
            }
        };

        const onVisitStart = (visit: { to: { url: string } }) => {
            const fromHome = isHomePath(window.location.pathname);
            const toPath = new URL(visit.to.url, window.location.origin)
                .pathname;
            const toHome = isHomePath(toPath);
            if (fromHome && !toHome) {
                applyWelcomeLayerVisible(false);
                clearTimers();
                const textEl = document.getElementById("banner-welcome-text");
                if (textEl) textEl.classList.add("opacity-0");
            }
        };

        state.bindFromDom = bindFromDom;
        state.render = render;
        state.step = step;
        state.start = start;
        state.clearTimers = clearTimers;
        state.syncWelcomeFromRoute = syncWelcomeFromRoute;
        state.onVisitStart = onVisitStart;

        if (!state.domListenersAttached) {
            state.domListenersAttached = true;

            window.addEventListener("load", () => {
                window.setTimeout(() => {
                    w[stateKey]!.syncWelcomeFromRoute();
                }, 120);
            });

            document.addEventListener("astro:page-load", () => {
                w[stateKey]!.syncWelcomeFromRoute();
            });
        }

        if (!state.swupHookAttached) {
            const attach = () => {
                if (!window.swup?.hooks || state.swupHookAttached) return;
                state.swupHookAttached = true;
                window.swup.hooks.on(
                    "visit:start",
                    (visit: { to: { url: string } }) => {
                        w[stateKey]!.onVisitStart(visit);
                    },
                );
            };
            if (window.swup?.hooks) {
                attach();
            } else if (!state.swupEnableListenerAttached) {
                state.swupEnableListenerAttached = true;
                document.addEventListener("swup:enable", () => attach(), {
                    once: true,
                });
            }
        }
    </script>

    <script is:inline>
        (() => {
            let cleanups = [];
            let observer = null;
            let pendingInitTimer = 0;

            const scheduleInitCardTilt = () => {
                if (pendingInitTimer) {
                    window.clearTimeout(pendingInitTimer);
                }
                pendingInitTimer = window.setTimeout(() => {
                    pendingInitTimer = 0;
                    initCardTilt();
                }, 40);
            };

            const initCardTilt = () => {
                cleanups.forEach((fn) => fn());
                cleanups = [];

                const cards = Array.from(
                    document.querySelectorAll(".card-base"),
                );
                if (cards.length === 0) return;

                const coarsePointer =
                    window.matchMedia("(pointer: coarse)").matches;
                const reduceMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;
                if (coarsePointer || reduceMotion) return;

                const clamp = (value, min, max) =>
                    Math.max(min, Math.min(max, value));

                for (const card of cards) {
                    let rafId = 0;
                    let currentX = 0;
                    let currentY = 0;
                    let targetX = 0;
                    let targetY = 0;
                    let pointerXPercent = 50;
                    let pointerYPercent = 50;

                    const computeTiltProfile = () => {
                        const rect = card.getBoundingClientRect();
                        const width = rect.width;
                        const height = rect.height;
                        const area = width * height;
                        const aspect = height / Math.max(width, 1);

                        // 超长内容面板（例如文章正文）不启用 3D 旋转
                        const isVeryTallPanel = height >= 900 && aspect >= 1.6;
                        const isExtremelyTallPanel = height >= 1400;
                        const disabled =
                            isVeryTallPanel || isExtremelyTallPanel;

                        if (disabled) {
                            return {
                                disabled: true,
                                isLargePanel: true,
                                maxRotate: 0,
                                enterBoost: 1,
                                smoothing: 0.12,
                                lift: "0px",
                                scale: "1",
                                glow: "0",
                            };
                        }

                        // 根据尺寸连续缩放，而不是粗略分组
                        // 尺寸越大，旋转越弱；尺寸越小，旋转更明显
                        const sizeFactor = clamp(
                            Math.min(width, height) / 620,
                            0,
                            1,
                        );
                        const areaFactor = clamp(area / 260000, 0, 1);
                        const damp = Math.max(sizeFactor, areaFactor);

                        const maxRotate = 12 - damp * 9.4; // 约 12deg -> 2.6deg
                        const enterBoost = 1.2 - damp * 0.32;
                        const smoothing = 0.14 - damp * 0.03;
                        const liftPx = 14 - damp * 10;
                        const scaleValue = 1.016 - damp * 0.015;
                        const glowValue = 0.5 - damp * 0.38;
                        const isLargePanel = damp >= 0.6;

                        return {
                            disabled: false,
                            isLargePanel,
                            maxRotate,
                            enterBoost,
                            smoothing,
                            lift: `${liftPx.toFixed(2)}px`,
                            scale: scaleValue.toFixed(4),
                            glow: glowValue.toFixed(3),
                        };
                    };

                    let maxRotate = 0;
                    let enterBoost = 1;
                    let smoothing = 0.12;
                    let isLargePanel = false;
                    let tiltDisabled = false;

                    const applyProfile = () => {
                        const profile = computeTiltProfile();
                        maxRotate = profile.maxRotate;
                        enterBoost = profile.enterBoost;
                        smoothing = profile.smoothing;
                        isLargePanel = profile.isLargePanel;
                        tiltDisabled = profile.disabled;

                        card.style.setProperty(
                            "--tilt-lift-active",
                            profile.lift,
                        );
                        card.style.setProperty(
                            "--tilt-scale-active",
                            profile.scale,
                        );
                        card.style.setProperty(
                            "--tilt-glow-active",
                            profile.glow,
                        );

                        if (tiltDisabled) {
                            card.classList.remove("is-tilting");
                            card.classList.remove("is-tilting-large");
                        }
                    };

                    applyProfile();

                    const render = () => {
                        currentX += (targetX - currentX) * smoothing;
                        currentY += (targetY - currentY) * smoothing;

                        card.style.setProperty(
                            "--tilt-rotate-x",
                            `${currentX.toFixed(2)}deg`,
                        );
                        card.style.setProperty(
                            "--tilt-rotate-y",
                            `${currentY.toFixed(2)}deg`,
                        );
                        card.style.setProperty(
                            "--tilt-pointer-x",
                            `${pointerXPercent.toFixed(2)}%`,
                        );
                        card.style.setProperty(
                            "--tilt-pointer-y",
                            `${pointerYPercent.toFixed(2)}%`,
                        );

                        if (
                            Math.abs(targetX - currentX) > 0.03 ||
                            Math.abs(targetY - currentY) > 0.03
                        ) {
                            rafId = window.requestAnimationFrame(render);
                        } else {
                            rafId = 0;
                        }
                    };

                    const run = () => {
                        if (!rafId) {
                            rafId = window.requestAnimationFrame(render);
                        }
                    };

                    const onPointerMove = (event) => {
                        if (tiltDisabled) return;

                        const rect = card.getBoundingClientRect();
                        const x = clamp(
                            (event.clientX - rect.left) / rect.width,
                            0,
                            1,
                        );
                        const y = clamp(
                            (event.clientY - rect.top) / rect.height,
                            0,
                            1,
                        );

                        pointerXPercent = x * 100;
                        pointerYPercent = y * 100;

                        targetX = (0.5 - y) * maxRotate * enterBoost;
                        targetY = (x - 0.5) * maxRotate * enterBoost;

                        run();
                    };

                    const onPointerEnter = (event) => {
                        applyProfile();
                        if (tiltDisabled) return;

                        card.classList.add("is-tilting");
                        card.classList.toggle("is-tilting-large", isLargePanel);
                        onPointerMove(event);
                    };

                    const reset = () => {
                        targetX = 0;
                        targetY = 0;
                        pointerXPercent = 50;
                        pointerYPercent = 50;
                        card.classList.remove("is-tilting");
                        card.classList.remove("is-tilting-large");
                        run();
                    };

                    const onResize = () => {
                        applyProfile();
                        if (tiltDisabled) {
                            reset();
                        }
                    };

                    card.addEventListener("pointerenter", onPointerEnter);
                    card.addEventListener("pointermove", onPointerMove);
                    card.addEventListener("pointerleave", reset);
                    card.addEventListener("pointercancel", reset);
                    window.addEventListener("resize", onResize, {
                        passive: true,
                    });

                    cleanups.push(() => {
                        card.removeEventListener(
                            "pointerenter",
                            onPointerEnter,
                        );
                        card.removeEventListener("pointermove", onPointerMove);
                        card.removeEventListener("pointerleave", reset);
                        card.removeEventListener("pointercancel", reset);
                        window.removeEventListener("resize", onResize);
                        if (rafId) {
                            window.cancelAnimationFrame(rafId);
                            rafId = 0;
                        }
                        card.classList.remove("is-tilting");
                        card.classList.remove("is-tilting-large");
                        card.style.removeProperty("--tilt-rotate-x");
                        card.style.removeProperty("--tilt-rotate-y");
                        card.style.removeProperty("--tilt-pointer-x");
                        card.style.removeProperty("--tilt-pointer-y");
                        card.style.removeProperty("--tilt-lift-active");
                        card.style.removeProperty("--tilt-scale-active");
                        card.style.removeProperty("--tilt-glow-active");
                    });
                }
            };

            initCardTilt();
            document.addEventListener("astro:page-load", scheduleInitCardTilt);

            observer = new MutationObserver((mutations) => {
                for (const mutation of mutations) {
                    for (const node of mutation.addedNodes) {
                        if (!(node instanceof HTMLElement)) continue;
                        if (
                            node.classList?.contains("card-base") ||
                            node.querySelector?.(".card-base")
                        ) {
                            scheduleInitCardTilt();
                            return;
                        }
                    }
                }
            });

            observer.observe(document.body, { childList: true, subtree: true });

            document.addEventListener("astro:before-swap", () => {
                cleanups.forEach((fn) => fn());
                cleanups = [];
                if (pendingInitTimer) {
                    window.clearTimeout(pendingInitTimer);
                    pendingInitTimer = 0;
                }
            });

            window.addEventListener("beforeunload", () => {
                cleanups.forEach((fn) => fn());
                cleanups = [];
                if (observer) {
                    observer.disconnect();
                    observer = null;
                }
                if (pendingInitTimer) {
                    window.clearTimeout(pendingInitTimer);
                    pendingInitTimer = 0;
                }
            });
        })();
    </script>
</Layout>
